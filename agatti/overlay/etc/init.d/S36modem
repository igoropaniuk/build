#!/bin/sh
# Bring up the modem DSP, which hosts the WLAN firmware. tqftpserv serves
# the files the modem asks for over QRTR (wlanmdsp.mbn from
# /lib/firmware/qcom/qcm2290), rmtfs serves the EFS partitions
# (modemst1/2, fsg, fsc, by GPT label) through the rmtfs shared memory.
# The modem is started here once both listen (rmtfs -s would do it too,
# but restarts it on every rmtfs hiccup). The ath10k_snoc driver brings up
# wlan0 when the WLAN firmware reports ready, some 7 s after the start.

modem_rproc() {
	for r in /sys/class/remoteproc/remoteproc*; do
		[ "$(cat $r/name 2>/dev/null)" = modem ] && echo $r && return
	done
}

case "$1" in
start)
	[ -e /dev/qcom_rmtfs_mem1 ] || { echo "modem: no rmtfs memory"; exit 0; }
	start-stop-daemon -S -b -q -x /usr/bin/tqftpserv
	start-stop-daemon -S -b -q -x /usr/bin/rmtfs -- -P
	M=$(modem_rproc)
	if [ -n "$M" ]; then
		echo start > $M/state 2>/dev/null && echo "modem: tqftpserv and rmtfs started, modem starting" \
			|| echo "modem: tqftpserv and rmtfs started, modem start failed"
	else
		echo "modem: tqftpserv and rmtfs started, no modem remoteproc"
	fi
	;;
stop)
	M=$(modem_rproc)
	[ -n "$M" ] && echo stop > $M/state 2>/dev/null
	start-stop-daemon -K -q -x /usr/bin/rmtfs
	start-stop-daemon -K -q -x /usr/bin/tqftpserv
	;;
esac
exit 0
