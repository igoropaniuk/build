#!/bin/sh
# Hardware video test on the venus core: encode a test pattern to H.264
# with the V4L2 encoder, then decode it back with the V4L2 decoder, and
# report the frame counts. No display needed.
N=${1:-300}
OUT=/tmp/venus-test.h264
v4l2-ctl --list-devices
echo "== encode $N frames 1280x720 -> $OUT (v4l2h264enc)"
gst-launch-1.0 -e videotestsrc num-buffers="$N" pattern=smpte ! \
	video/x-raw,format=NV12,width=1280,height=720,framerate=30/1 ! \
	v4l2h264enc ! h264parse ! filesink location="$OUT" || exit 1
ls -l "$OUT"
echo "== decode $OUT (v4l2h264dec), count frames"
gst-launch-1.0 -v filesrc location="$OUT" ! h264parse ! v4l2h264dec ! \
	fpsdisplaysink video-sink=fakesink text-overlay=false sync=false 2>&1 | \
	grep -E 'last-message|rendered|ERROR' | tail -3
