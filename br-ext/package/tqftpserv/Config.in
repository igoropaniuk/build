config BR2_PACKAGE_TQFTPSERV
	bool "tqftpserv"
	select BR2_PACKAGE_QRTR
	select BR2_PACKAGE_ZSTD
	help
	  TFTP server over QRTR: hands the modem the files it asks for
	  (the WLAN firmware wlanmdsp.mbn among them) from the directory
	  of its remoteproc firmware under /lib/firmware.

	  https://github.com/linux-msm/tqftpserv
